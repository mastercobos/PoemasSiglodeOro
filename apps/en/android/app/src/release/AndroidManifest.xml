<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The app makes no network calls. These two come from Play Billing's
         telemetry library, through the in_app_purchase plugin. Release only:
         debug and profile need INTERNET for flutter run. Delete both lines if
         an app ever turns tips on. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
</manifest>
